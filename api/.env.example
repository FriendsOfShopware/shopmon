# Security
APP_SECRET=RU8f0yb6JpnyGnzBgovqAYNTaEULP1h1

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shopmon.io

# Sitespeed.io Service
APP_SITESPEED_ENDPOINT=http://localhost:3001
APP_SITESPEED_PREFIX=local-
APP_SITESPEED_API_KEY=secret

# OAuth Providers
APP_OAUTH_GITHUB_CLIENT_ID=
APP_OAUTH_GITHUB_CLIENT_SECRET=

# Application
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://shopmon:shopmon@localhost:5432/shopmon

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Background job queue: "postgres" (default) or "amqp" (RabbitMQ/LavinMQ).
# The AMQP_* settings below are only read when QUEUE_TRANSPORT=amqp.
QUEUE_TRANSPORT=postgres
QUEUE_AMQP_DSN=amqp://guest:guest@localhost:5672/
QUEUE_AMQP_EXCHANGE=shopmon
QUEUE_AMQP_QUEUE=shopmon
QUEUE_AMQP_PREFETCH=10
# Delayed jobs need a broker that supports x-delayed-message: LavinMQ natively,
# RabbitMQ via the delayed-message plugin. Set to false only if yours does not
# — delayed jobs are then delivered immediately.
QUEUE_AMQP_DELAYED_EXCHANGE=true

# S3 Storage (MinIO in development)
APP_S3_ENDPOINT=http://localhost:9000
APP_S3_ACCESS_KEY_ID=rustfsadmin
APP_S3_SECRET_ACCESS_KEY=rustfsadmin
APP_S3_BUCKET=shopmon
APP_S3_REGION=auto

# Packages Mirror (optional)
PACKAGES_API_URL=
PACKAGES_API_TOKEN=

# OpenTelemetry (Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=shopmon

# Auth rate limit: requests per IP per minute on auth routes (default 20).
# Raise it for local E2E test runs that exercise many auth-touching requests.
AUTH_RATE_LIMIT_MAX=20
